    </visual>
    <collision>
      <origin xyz="0 -0.030 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.060"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.030 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0000578" ixy="0" ixz="0"
               iyy="0.0000257" iyz="0"
               izz="0.0000578"/>
    </inertial>
  </link>

  <joint name="rear_left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_motor_link"/>
    <origin xyz="-0.0875 0.066 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_motor_link">
    <!-- Output shaft -->
    <visual>
      <origin xyz="0 0.01525 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0305"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Gearbox -->
    <visual>
      <origin xyz="0 -0.011 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.022"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Motor body -->
    <visual>
