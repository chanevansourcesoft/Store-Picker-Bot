<?xml version="1.0"?>
<!--
  4WD mecanum robot, as built: stock chassis + wooden electronics deck +
  raised acrylic top plate + RPLidar A1 at the front of the top plate.

  Frames (REP-103: x forward, y left, z up). "Front" = the LiDAR end.
    base_footprint : on the ground under the chassis centre
    base_link      : chassis centre at wheel-axle height (40 mm above ground)
    *_motor_link   : gear motor + encoder behind each wheel (gearbox output face)
    jetson_link    : centre of the Jetson board, on the wooden deck
    battery_link   : battery pack under the deck (assumed)
    camera_link / camera_optical_frame : front camera (assumed placement)
    imu_link       : IMU frame on the deck
    arm_mount_link : top-plate mounting frame for a future arm
    lidar_link     : LiDAR scan centre (scan plane), 151 mm above ground
    *_wheel_link   : wheel hub; *_roller_N_link : the 10 passive rollers on each wheel

  Heights above ground:
    bottom plate 17-20 mm | wooden deck 63.5-66.5 mm | top plate 103-106 mm
-->
<robot name="mecanum_robot">

  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="dark_grey"><color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1.0"/></material>
  <material name="wood"><color rgba="0.76 0.60 0.42 1.0"/></material>
  <material name="jetson_blue"><color rgba="0.10 0.45 0.65 1.0"/></material>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.040" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Acrylic top plate 250 x 150 x 3 mm, raised on standoffs -->
    <visual>
      <origin xyz="0 0 0.0645" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.150 0.003"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- Wooden electronics deck 210 x 140 x 3 mm -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.210 0.140 0.003"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <!-- Bottom chassis plate 200 x 130 x 3 mm -->
    <visual>
      <origin xyz="0 0 -0.0215" rpy="0 0 0"/>
      <geometry>
        <box size="0.200 0.130 0.003"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- Standoffs between deck and top plate -->
    <visual>
      <origin xyz="0.095 0.060 0.04475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0365"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.095 -0.060 0.04475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0365"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.095 0.060 0.04475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0365"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="-0.095 -0.060 0.04475" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0365"/>
      </geometry>
      <material name="black"/>
    </visual>

    <!-- One box from the bottom plate to the top plate -->
    <collision>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.150 0.089"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.001901" ixy="0" ixz="0"
               iyy="0.004401" iyz="0"
               izz="0.005313"/>
    </inertial>
  </link>

  <!-- ===================== Drive motors ===================== -->
  <!-- 37 mm DC gear motors with hall quadrature encoders (JGB37-520 class), 0.15 kg each.
       Frame origin = centre of the gearbox output face; local +y points along the
       shaft toward the wheel (right-side motors are yawed 180 deg). -->

  <link name="front_left_motor_link">
    <!-- Output shaft -->
    <visual>
      <origin xyz="0 0.01525 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0305"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Gearbox -->
    <visual>
      <origin xyz="0 -0.011 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.022"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Motor body -->
    <visual>
      <origin xyz="0 -0.037 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.030"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Encoder board -->
    <visual>
      <origin xyz="0 -0.056 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.030 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.060"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.030 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0000578" ixy="0" ixz="0"
               iyy="0.0000257" iyz="0"
               izz="0.0000578"/>
    </inertial>
  </link>

  <joint name="front_left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_motor_link"/>
    <origin xyz="0.0875 0.066 0" rpy="0 0 0"/>
  </joint>

  <link name="front_right_motor_link">
    <!-- Output shaft -->
    <visual>
      <origin xyz="0 0.01525 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0305"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Gearbox -->
    <visual>
      <origin xyz="0 -0.011 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.022"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Motor body -->
    <visual>
      <origin xyz="0 -0.037 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.030"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Encoder board -->
    <visual>
      <origin xyz="0 -0.056 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.008"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.030 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.060"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.030 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0000578" ixy="0" ixz="0"
               iyy="0.0000257" iyz="0"
               izz="0.0000578"/>
    </inertial>
  </link>

  <joint name="front_right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_motor_link"/>
    <origin xyz="0.0875 -0.066 0" rpy="0 0 3.14159"/>
  </joint>

  <link name="rear_left_motor_link">
    <!-- Output shaft -->
    <visual>
      <origin xyz="0 0.01525 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.0305"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Gearbox -->
    <visual>
      <origin xyz="0 -0.011 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0185" length="0.022"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Motor body -->
    <visual>
      <origin xyz="0 -0.037 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.030"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Encoder board -->
    <visual>
      <origin xyz="0 -0.056 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0165" length="0.008"/>
      </geometry>
