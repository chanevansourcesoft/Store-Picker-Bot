  </link>

  <joint name="rear_right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_motor_link"/>
    <origin xyz="-0.0875 -0.066 0" rpy="0 0 3.14159"/>
  </joint>

  <!-- ===================== Mecanum wheels ===================== -->
  <!-- 80 mm wheels: hub + 10 free-spinning rollers at 45 deg to the axle.
       Wheelbase 175 mm, track 193 mm.
       Handedness: seen from above, the top rollers form an X
       (front_left / rear_right = +45 deg, front_right / rear_left = -45 deg).
       Inverse kinematics for this layout (r = 0.040, k = 0.0875 + 0.0965 = 0.184):
         front_left  = (vx - vy - k*wz) / r
         front_right = (vx + vy + k*wz) / r
         rear_left   = (vx + vy - k*wz) / r
         rear_right  = (vx - vy + k*wz) / r
       Only the four *_wheel_joint are driven; all *_roller_*_joint are passive.
       Roller contact = 5 spheres on a barrel profile, so the wheel rolls on a true 40 mm radius.
       Wheel limits assume the 12 V / ~300 rpm motor version (31.4 rad/s, 0.5 N*m): edit to match yours. -->

  <!-- ========== front_left (+45 deg rollers) ========== -->
  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.030"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.030"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.0000154" ixy="0" ixz="0"
               iyy="0.0000154" iyz="0"
               izz="0.0000219"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.0875 0.0965 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" velocity="31.4"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <link name="front_left_roller_0_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.036"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.018 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.00370"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.009 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.00541"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.00600"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.009 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.00541"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.018 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.00370"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <mass value="0.004"/>
      <inertia ixx="0.000000569" ixy="0" ixz="0"
               iyy="0.000000569" iyz="0"
               izz="0.000000072"/>
    </inertial>
  </link>

  <joint name="front_left_roller_0_joint" type="continuous">
    <parent link="front_left_wheel_link"/>
    <child link="front_left_roller_0_link"/>
    <origin xyz="0 0 0.034" rpy="0 0 0.7854"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.0005" friction="0.0"/>
  </joint>

  <link name="front_left_roller_1_link">
