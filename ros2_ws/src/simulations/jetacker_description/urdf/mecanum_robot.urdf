  <!-- ===================== Jetson ===================== -->
  <!-- Jetson developer kit (100 x 80 x 29 mm, 0.25 kg) on the wooden deck, rear half.
       Frame origin = centre of the board; deck surface is z = 0.0265 in base_link. -->
  <link name="jetson_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.100 0.080 0.029"/>
      </geometry>
      <material name="jetson_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.100 0.080 0.029"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000151" ixy="0" ixz="0"
               iyy="0.000226" iyz="0"
               izz="0.000342"/>
    </inertial>
  </link>

  <joint name="jetson_joint" type="fixed">
    <parent link="base_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.045 0 0.041" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LiDAR (RPLidar A1) ===================== -->
  <!-- Frame origin = scan centre. Unit is 55 mm tall; scan plane 45 mm above the top plate. -->
  <link name="lidar_link">
    <!-- Base with belt motor -->
    <visual>
      <origin xyz="0 0 -0.0325" rpy="0 0 0"/>
      <geometry>
        <box size="0.070 0.097 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <!-- Rotating scanner head -->
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.030"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia ixx="0.000149" ixy="0" ixz="0"
               iyy="0.000149" iyz="0"
               izz="0.000213"/>
    </inertial>
  </link>

  <!-- 80 mm ahead of centre, on the centreline; top plate surface is z = 0.066 in base_link.
       Set the yaw (rpy) here to match how the A1's zero-angle is pointing on your robot. -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.080 0 0.111" rpy="0 0 0"/>
  </joint>

  <!-- The scan frame, NOT lidar_link.
       The RPLidar A1 driver stamps every LaserScan with frame_id "lidar_frame"
       (/home/ubuntu/.sllidar_params.yaml, owned by lidar_watchdog.service). Without this link
       in the TF tree slam_toolbox, both costmaps and the collision monitor silently drop every
       scan, so it must exist and must keep this exact name.

       The yaw below is the A1's zero-angle direction relative to the robot. pi means the
       sensor's 0 deg points BACKWARDS, which is how it was mounted on the Ackermann build
       (see jetacker_description/urdf/lidar_a1.urdf.xacro).

       VERIFIED ON THIS ROBOT 2026-10-09 with
       mecanum_nav/scripts/check_lidar_orientation.py in differential mode: an obstacle placed
       in front of the robot appeared in the FRONT sector under this pi value (0.25 m, bearing
       -3 deg) and in the REAR sector under rpy="0 0 0". So pi is correct and this must not be
       "corrected" to zero.

       If the LiDAR is ever remounted, re-run that check. A 180 deg error still builds a map
       that looks perfectly plausible while being mirrored, and it makes the robot swerve away
       from phantom obstacles into real ones, with nothing warning you. -->
  <link name="lidar_frame"/>

  <joint name="lidar_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_frame"/>
    <origin xyz="0 0 0" rpy="0 0 3.14159265358979"/>
  </joint>

  <!-- ===================== Battery ===================== -->
  <!-- ASSUMED: 3S LiPo-size pack (105 x 35 x 25 mm, 0.2 kg) between the motors, under the deck. -->
  <link name="battery_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.105 0.035 0.025"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.105 0.035 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0000308" ixy="0" ixz="0"
               iyy="0.0001942" iyz="0"
               izz="0.0002042"/>
    </inertial>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 -0.005" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Camera ===================== -->
  <!-- ASSUMED: forward-facing depth camera (90 x 25 x 25 mm) on the front edge of the deck,
       below the top plate. camera_link: x forward, y left, z up. -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.07"/>
      <inertia ixx="0.0000509" ixy="0" ixz="0"
               iyy="0.0000073" iyz="0"
               izz="0.0000509"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.1175 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- Optical convention: z forward, x right, y down. Attach the simulated camera here. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== IMU ===================== -->
  <!-- Frame only, on the deck at the chassis centre, axes aligned with base_link. -->
  <link name="imu_link"/>

  <!-- 2026-10-22: roll pi, because the controller board's IMU is mounted UPSIDE DOWN. MEASURED at rest:
       linear_acceleration.z = -9.19 m/s^2 (REP-103 expects +9.8 with z up), and a commanded
       anticlockwise turn that the robot physically made clockwise read POSITIVE on the gyro.
       With rpy 0 the EKF fused a yaw rate of the wrong sign against rf2o's correct one.
       robot_localization rotates IMU data through this transform, so roll pi flips z back.
       OLD: rpy="0 0 0" -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.0265" rpy="3.14159265358979 0 0"/>
  </joint>

  <!-- ===================== Arm mount ===================== -->
  <!-- Frame only: top-plate surface behind the LiDAR. Attach the arm base here later. -->
  <link name="arm_mount_link"/>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
    <origin xyz="-0.045 0 0.066" rpy="0 0 0"/>
  </joint>

</robot>