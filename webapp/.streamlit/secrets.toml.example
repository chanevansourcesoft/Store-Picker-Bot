# Copy this file to .streamlit/secrets.toml and put your real key there.
# On Streamlit Community Cloud: paste these lines into App settings -> Secrets.
# Never commit secrets.toml (it is in .gitignore).

NEBIUS_API_KEY = "your-nebius-token-factory-key"

# Optional:
# ROBOT_URL = "http://192.168.1.50:8000"   # real robot (Jetson)
# DEMO_MODE = "1"                           # always use the simulated robot
