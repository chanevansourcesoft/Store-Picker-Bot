# Copy to .env and fill in. Never commit .env.

# Hugging Face: datasets, model weights, and gated access to nvidia/Cosmos-Reason2-2B
HF_TOKEN=
HF_USER=

# Nebius Token Factory (OpenAI-compatible API) for Nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# SO-100 arms and cameras (policy/), stable names from:
#   ls -l /dev/serial/by-id/     ls -l /dev/v4l/by-id/
# See policy/docs/ARM_SETUP.md (step 1) and policy/docs/CAMERA_SETUP.md (step 2).
FOLLOWER_PORT=
LEADER_PORT=
GRIPPER_CAM=
SCENE_CAM=

# Mecanum base (ros2_ws/). Ports: stable names from  ls -l /dev/serial/by-id/
# Empty = the udev names /dev/rrc and /dev/lidar. See ros2_ws/README.md.
BASE_BOARD_PORT=
LIDAR_PORT=
LIDAR_TYPE=A1
ROS_DOMAIN_ID=0
