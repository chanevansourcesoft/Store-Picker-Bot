# Copy to storepilot/.env. Never commit .env.

# mock = built-in simulator (clearly labelled SIMULATED everywhere)
# live = talk to the Jetson robot server (webapp/robot_server/jetson_server.py, Contract v2)
STOREPILOT_MODE=mock

# Jetson robot server base URL (live mode only), e.g. http://192.168.2.50:8000
JETSON_URL=

# Live mode safety switches (both off by default):
# 1 = the operator may start missions that physically move the robot
STOREPILOT_ENABLE_MOTION=0
# 1 = you confirmed that POST /stop on the Jetson really halts the robot
JETSON_STOP_CONFIRMED=0

# Nemotron on Nebius Token Factory (stays on the server, never sent to the browser).
# Without it, orders are parsed by keywords and planned by the offline autopilot.
NEBIUS_API_KEY=

# Dashboard server
STOREPILOT_HOST=127.0.0.1
STOREPILOT_PORT=8080
