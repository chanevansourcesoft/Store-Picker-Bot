# Copy to storepilot/.env. Never commit .env.

# mock = built-in simulator (clearly labelled SIMULATED everywhere)
# live = talk to the Jetson robot server (agent/robot_server/jetson_server.py, Contract v2)
STOREPILOT_MODE=mock

# How live mode reaches the Jetson:
#   rosbridge = Nav2 directly via rosbridge_websocket (driving, live map, map switching)  <- current robot
#   http      = jetson_server.py (Contract v2)
JETSON_LINK=rosbridge
ROSBRIDGE_URL=ws://192.168.20.185:9090
JETSON_MAPS_DIR=/home/ubuntu/ros2_ws/src/slam/maps
# JETSON_MAPS=conf3,conf2,...   (default: the 15 working maps on the robot)
ROS_BASE_FRAME=base_footprint
ROS_BATTERY_TOPIC=/ros_robot_controller/battery

# Jetson robot server base URL (JETSON_LINK=http only), e.g. http://192.168.2.50:8000
JETSON_URL=

# Live mode safety switches (both off by default):
# 1 = the operator may start missions that physically move the robot
STOREPILOT_ENABLE_MOTION=0
# 1 = you physically verified that POST /stop on the Jetson halts BOTH the base and the arm
JETSON_STOP_CONFIRMED=0
# 1 = the GR00T pick on the Jetson (pick + place in basket, robot_server/arm.py) is real, not the stub
STOREPILOT_MANIPULATION_VERIFIED=0
# Live telemetry you checked against the robot (comma list of: pose,battery,speed). Others show "Unavailable".
STOREPILOT_VERIFIED_TELEMETRY=

# Nemotron on Nebius Token Factory (stays on the server, never sent to the browser).
# Without it, orders are parsed by keywords and planned by the offline autopilot.
NEBIUS_API_KEY=

# Real robot page: the team password needed to upload / add / delete videos (anyone can watch).
# Empty = no uploads: the page only plays the videos already in data/videos.
STOREPILOT_UPLOAD_PASSWORD=
# STOREPILOT_MAX_VIDEO_MB=500
# Live robot camera (live mode only): an MJPEG stream URL the browser can open. Empty = the
# Operations page plays the newest real robot video instead.
STOREPILOT_CAMERA_URL=

# Dashboard server
STOREPILOT_HOST=127.0.0.1
STOREPILOT_PORT=8080

# QuickPick (Streamlit kiosk + owner dashboard, storepilot/quickpick)
# DEMO_MODE=1 = always use the in-process simulated robot
DEMO_MODE=0
ROBOT_URL=http://localhost:8000
# ROSBRIDGE_URL above is also used by the QuickPick live map
# LASER_OFFSET=0,0,0

# Live stock shared by both apps (runtime, not in Git). Products: agent/store_agent/catalog.json
# STOCK_FILE=/path/to/stock.json   (default <repo>/data/stock.json)
